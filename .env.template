# =====================================================
# Claude Code 内网环境配置 (Windows x64)
# 拷贝到 U 盘根目录后,重命名为 .env 并填入实际值
# =====================================================

# ============== 必填: API 连接信息 ==============

# New API 服务地址 (Anthropic 兼容端点)
# New API 默认监听 3000 端口,Anthropic 端点路径为 /v1
# 示例: http://10.0.0.50:3000/v1
ANTHROPIC_BASE_URL=http://<NEWAPI_HOST>:<PORT>/v1

# New API 控制台生成的 API Key
# (在 New API -> 渠道/令牌 里创建,绑定 GLM-5.1-AWQ-4bit 模型)
ANTHROPIC_AUTH_TOKEN=<YOUR_NEWAPI_KEY>

# 模型名,必须与 New API 渠道里配置的模型名完全一致
ANTHROPIC_MODEL=GLM-5.1-AWQ-4bit

# ============== 内网气隙隔离: 关掉所有外网回拨 ==============
# 以下变量全部=1 即可,无副作用,仅关闭"非必要"的外部通信
# 关闭后 Claude Code 仅与 ANTHROPIC_BASE_URL 通信,绝不触碰外网

# 关闭自动更新检查 (默认会去 downloads.claude.ai 拉版本,会等超时)
DISABLE_AUTOUPDATER=1

# 关闭所有"非必要"网络流量 (埋点、统计、健康检查等)
DISABLE_NONESSENTIAL_TRAFFIC=1

# 关闭错误上报 (异常时不会回传到 beacon.claude-ai.staging.ant.dev)
DISABLE_ERROR_REPORTING=1

# 关闭遥测/统计 (基于 Anthropic 服务条款的匿名统计)
DISABLE_TELEMETRY=1

# 关闭安装时检查 (claude install 不会再校验外网)
DISABLE_INSTALLATION_CHECKS=1

# 关闭 GrowthBook 特性开关 (否则会向 gbhq.anthropic.com 拉开关)
DISABLE_GROWTHBOOK=1

# ============== 可选: 高级配置 ==============

# 自定义 Claude Code 入口标记 (默认 cli 即可)
CLAUDE_CODE_ENTRYPOINT=cli
